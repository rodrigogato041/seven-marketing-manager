{
  "name": "seven-instagram-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,worker -c cyan,magenta \"next dev\" \"tsx watch src/worker/index.ts\"",
    "dev:web": "next dev",
    "worker": "tsx src/worker/index.ts",
    "build": "next build",
    "start": "concurrently -k -n web,worker -c cyan,magenta \"next start\" \"tsx src/worker/index.ts\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:backup": "tsx src/db/backup.ts"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "dotenv": "17.2.3",
    "drizzle-orm": "0.45.4",
    "next": "16.4.3",
    "openai": "7.43.0",
    "playwright-core": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.14",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.7.0",
    "@types/react": "19.2.1",
    "@types/react-dom": "19.2.1",
    "concurrently": "9.2.1",
    "drizzle-kit": "0.31.5",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "4.1.14",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@10.4.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@tailwindcss/oxide",
      "better-sqlite3",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
